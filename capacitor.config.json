{
  "appId": "com.tailorshop.manager",
  "appName": "Tailor Shop Manager",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "overscrollBackground": "none",
    "backgroundColor": "#7c3aed",
    "allowMixedContent": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#ffffff",
      "showSpinner": false
    }
  }
}
