rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow read/write access to all users for now
    // For production, add proper authentication
    match /{allPaths=**} {
      allow read, write: if true;
    }
    
    // Customer photos
    match /customers/photos/{fileName} {
      allow read, write: if true;
    }
    
    // Order fabric photos
    match /orders/fabric/{fileName} {
      allow read, write: if true;
    }
    
    // Order design photos
    match /orders/design/{fileName} {
      allow read, write: if true;
    }
  }
}
